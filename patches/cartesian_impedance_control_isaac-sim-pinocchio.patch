index 0000000..8839acf
--- /dev/null
+++ b/src/pinocchio_model.cpp
@@ -0,0 +1,117 @@
+// Pinocchio headers first (Boost.MPL limits must be set before other Boost users).
+#include <pinocchio/algorithm/crba.hpp>
+#include <pinocchio/algorithm/frames.hpp>
+#include <pinocchio/algorithm/jacobian.hpp>
+#include <pinocchio/algorithm/joint-configuration.hpp>
+#include <pinocchio/algorithm/model.hpp>
+#include <pinocchio/algorithm/rnea.hpp>
+#include <pinocchio/multibody/data.hpp>
+#include <pinocchio/multibody/model.hpp>
+#include <pinocchio/parsers/urdf.hpp>
+
+#include "cartesian_impedance_control/pinocchio_model.hpp"
+
+#include <algorithm>
+#include <stdexcept>
+
+namespace cartesian_impedance_control {
+
+struct PinocchioModel::Impl {
+  pinocchio::Model model;
+  pinocchio::Data data;
+  pinocchio::FrameIndex ee_frame_id{0};
+  std::vector<int> q_idx;  // controller joint i -> index in model q
+  std::vector<int> v_idx;  // controller joint i -> index in model v
+  Eigen::VectorXd q, v;
+  Eigen::Matrix<double, 6, Eigen::Dynamic> J_full;
+};
+
+PinocchioModel::PinocchioModel(const std::string& urdf_path,
+                               const std::vector<std::string>& arm_joints,
+                               const std::string& ee_frame)
+    : impl_(std::make_unique<Impl>()) {
+  if (arm_joints.size() != 7) {
+    throw std::invalid_argument("PinocchioModel: expected 7 arm joints");
+  }
+
+  pinocchio::Model full;
+  pinocchio::urdf::buildModel(urdf_path, full);  // fixed base
+
+  for (const auto& name : arm_joints) {
+    if (!full.existJointName(name)) {
+      throw std::invalid_argument("PinocchioModel: joint '" + name + "' not in " + urdf_path);
+    }
+  }
+
+  // Lock every joint that is not commanded by the controller (fingers, ...).
+  std::vector<pinocchio::JointIndex> to_lock;
+  for (pinocchio::JointIndex j = 1; j < static_cast<pinocchio::JointIndex>(full.njoints); ++j) {
+    if (std::find(arm_joints.begin(), arm_joints.end(), full.names[j]) == arm_joints.end()) {
+      to_lock.push_back(j);
+    }
+  }
+  const Eigen::VectorXd q_ref = pinocchio::neutral(full);
+  impl_->model = pinocchio::buildReducedModel(full, to_lock, q_ref);
+  impl_->data = pinocchio::Data(impl_->model);
+
+  auto& m = impl_->model;
+  if (m.nv != 7 || m.nq != 7) {
+    throw std::runtime_error("PinocchioModel: reduced model does not have 7 DOF");
+  }
+  if (!m.existFrame(ee_frame)) {
+    throw std::invalid_argument("PinocchioModel: frame '" + ee_frame + "' not in " + urdf_path);
+  }
+  impl_->ee_frame_id = m.getFrameId(ee_frame);
+
+  for (const auto& name : arm_joints) {
+    const auto jid = m.getJointId(name);
+    impl_->q_idx.push_back(m.joints[jid].idx_q());
+    impl_->v_idx.push_back(m.joints[jid].idx_v());
+  }
+  impl_->q = Eigen::VectorXd::Zero(m.nq);
+  impl_->v = Eigen::VectorXd::Zero(m.nv);
+  impl_->J_full = Eigen::Matrix<double, 6, Eigen::Dynamic>::Zero(6, m.nv);
+}
+
+PinocchioModel::~PinocchioModel() = default;
+
+void PinocchioModel::compute(const Eigen::Matrix<double, 7, 1>& q,
+                             const Eigen::Matrix<double, 7, 1>& dq) {
+  auto& m = impl_->model;
+  auto& d = impl_->data;
+  for (int i = 0; i < 7; ++i) {
+    impl_->q[impl_->q_idx[i]] = q[i];
+    impl_->v[impl_->v_idx[i]] = dq[i];
+  }
+
+  // Mass matrix (crba fills the upper triangle only).
+  pinocchio::crba(m, d, impl_->q);
+  d.M.triangularView<Eigen::StrictlyLower>() = d.M.transpose().triangularView<Eigen::StrictlyLower>();
+
+  // Coriolis/centrifugal vector C(q, dq) dq, without gravity.
+  pinocchio::computeCoriolisMatrix(m, d, impl_->q, impl_->v);
+  const Eigen::VectorXd c = d.C * impl_->v;
+
+  // Kinematics, end-effector pose and Jacobian.
+  pinocchio::computeJointJacobians(m, d, impl_->q);  // also runs forward kinematics
+  pinocchio::updateFramePlacements(m, d);
+  impl_->J_full.setZero();
+  pinocchio::getFrameJacobian(m, d, impl_->ee_frame_id, pinocchio::LOCAL_WORLD_ALIGNED,
+                              impl_->J_full);
+
+  for (int i = 0; i < 7; ++i) {
+    const int vi = impl_->v_idx[i];
+    coriolis_[i] = c[vi];
+    J_.col(i) = impl_->J_full.col(vi);
+    for (int k = 0; k < 7; ++k) {
+      M_(i, k) = d.M(vi, impl_->v_idx[k]);
+    }
+  }
+
+  const auto& oMf = d.oMf[impl_->ee_frame_id];
+  pose_.setIdentity();
+  pose_.linear() = oMf.rotation();
+  pose_.translation() = oMf.translation();
+}
+
+}  // namespace cartesian_impedance_control
diff --git a/test/pinocchio_model_check.cpp b/test/pinocchio_model_check.cpp
new file mode 100644
index 0000000..54b211a
--- /dev/null
+++ b/test/pinocchio_model_check.cpp
@@ -0,0 +1,86 @@
+// Sanity check of PinocchioModel against libfranka reference values.
+// Usage: pinocchio_model_check [urdf_path] [ee_frame]
+// Exits with 0 if all checks pass.
+
+#include <cmath>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+#include <Eigen/Dense>
+
+#include "cartesian_impedance_control/pinocchio_model.hpp"
+
+namespace {
+
+int failures = 0;
+
+void check(bool ok, const std::string& what, double value) {
+  std::printf("[%s] %-40s %.3e\n", ok ? " OK " : "FAIL", what.c_str(), value);
+  if (!ok) {
+    ++failures;
+  }
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  const std::string urdf = argc > 1 ? argv[1] : "/home/njohnson/ci_mpc_assets/fr3.urdf";
+  const std::string ee_frame = argc > 2 ? argv[2] : "fr3_hand_tcp";
+  std::vector<std::string> joints;
+  for (int i = 1; i <= 7; ++i) {
+    joints.push_back("fr3_joint" + std::to_string(i));
+  }
+  cartesian_impedance_control::PinocchioModel model(urdf, joints, ee_frame);
+
+  // libfranka home pose
+  Eigen::Matrix<double, 7, 1> q;
+  q << 0.0, -M_PI_4, 0.0, -3.0 * M_PI_4, 0.0, M_PI_2, M_PI_4;
+  Eigen::Matrix<double, 7, 1> dq = Eigen::Matrix<double, 7, 1>::Zero();
+  model.compute(q, dq);
+
+  const Eigen::Vector3d p_ref(0.3069, 0.0, 0.4869);
+  const Eigen::Matrix3d R_ref = Eigen::Vector3d(1.0, -1.0, -1.0).asDiagonal();
+  const Eigen::Vector3d p = model.pose().translation();
+  std::printf("home TCP position: %.4f %.4f %.4f\n", p.x(), p.y(), p.z());
+  check((p - p_ref).norm() < 1e-3, "home TCP position vs libfranka", (p - p_ref).norm());
+  check((model.pose().linear() - R_ref).norm() < 1e-6, "home TCP rotation = diag(1,-1,-1)",
+        (model.pose().linear() - R_ref).norm());
+  check(model.coriolis().norm() < 1e-12, "coriolis(dq = 0) = 0", model.coriolis().norm());
+
+  // Random state
+  q << 0.3, -0.5, 0.2, -2.0, 0.4, 1.8, -0.3;
+  dq << 0.5, -0.4, 0.3, 0.6, -0.7, 0.2, 0.9;
+  model.compute(q, dq);
+  const Eigen::Matrix<double, 7, 7> M = model.mass();
+  check((M - M.transpose()).norm() < 1e-12, "M symmetric", (M - M.transpose()).norm());
+  const double min_eig = Eigen::SelfAdjointEigenSolver<Eigen::Matrix<double, 7, 7>>(M)
+                             .eigenvalues().minCoeff();
+  check(min_eig > 0.0, "M positive definite (min eigenvalue)", min_eig);
+  // C(q, dq) dq is quadratic in dq
+  const Eigen::Matrix<double, 7, 1> c1 = model.coriolis();
+  model.compute(q, 2.0 * dq);
+  check((model.coriolis() - 4.0 * c1).norm() < 1e-9, "coriolis quadratic in dq",
+        (model.coriolis() - 4.0 * c1).norm());
+
+  // Jacobian vs finite differences of the pose
+  model.compute(q, dq);
+  const Eigen::Matrix<double, 6, 7> J = model.jacobian();
+  const Eigen::Affine3d T0 = model.pose();
+  Eigen::Matrix<double, 6, 7> J_fd;
+  const double h = 1e-7;
+  for (int i = 0; i < 7; ++i) {
+    Eigen::Matrix<double, 7, 1> qp = q;
+    qp[i] += h;
+    model.compute(qp, dq);
+    const Eigen::Affine3d T1 = model.pose();
+    J_fd.block<3, 1>(0, i) = (T1.translation() - T0.translation()) / h;
+    const Eigen::AngleAxisd aa(T1.linear() * T0.linear().transpose());
+    J_fd.block<3, 1>(3, i) = aa.axis() * aa.angle() / h;
+  }
+  check((J - J_fd).cwiseAbs().maxCoeff() < 1e-5, "jacobian vs finite differences",
+        (J - J_fd).cwiseAbs().maxCoeff());
+
+  std::printf("%s\n", failures == 0 ? "ALL CHECKS PASSED" : "SOME CHECKS FAILED");
+  return failures == 0 ? 0 : 1;
+}
-- 
