<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ci_mpc_planner</name>
  <version>0.1.0</version>
  <description>Stage-1 MPC for the FR3: end-effector trajectory QP (OSQP) on top of the Cartesian impedance controller</description>
  <maintainer email="dr.nils1@gmail.com">Nils Johnson</maintainer>
  <license>Apache 2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ci_mpc_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>pinocchio</exec_depend>
  <!-- OSQP is not packaged for Humble: install it with pip in user mode (tested with osqp 1.1.3) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
